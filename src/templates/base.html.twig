<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        {% set base_url = 'https://wecreate-services.com' %}
        {# A page can pass its own og_image; otherwise everything shares one. #}
        {% set og_image = og_image|default(base_url ~ asset('assets/img/banner/banner-img-2.png')) %}
        <!-- Required meta tags -->
        {{ meta_tags() }}
        <!-- Favicon -->
        <link rel="icon" type="image/svg+xml" href="{{ asset('assets/img/fevicon.svg') }}">

        <!-- Open Graph -->
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="WeCreate">
        <meta property="og:locale" content="en_US">
        <meta property="og:title" content="{{ og_title|default('WeCreate') }}">
        <meta property="og:description" content="{{ og_description|default('WeCreate builds software, websites, and mobile applications for companies and individuals.') }}">
        <meta property="og:url" content="{{ og_url|default(base_url ~ '/') }}">
        <meta property="og:image" content="{{ og_image }}">

        <!-- Twitter card -->
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ og_title|default('WeCreate') }}">
        <meta name="twitter:description" content="{{ og_description|default('WeCreate builds software, websites, and mobile applications for companies and individuals.') }}">
        <meta name="twitter:image" content="{{ og_image }}">

        <!-- Structured data -->
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "WeCreate",
            "url": "{{ base_url }}/",
            "logo": "{{ base_url ~ asset('assets/img/logo/logo.svg') }}",
            "description": "WeCreate is a platform to provide services for companies and individuals to create software, websites, and applications.",
            "sameAs": [
                "https://rsvp.wecreate-services.com/",
                "https://wobble.wecreate-services.com/",
                "https://flipdrop.wecreate-services.com/"
            ]
        }
        </script>

        {% block stylesheets %}
        {% endblock %}

        {% block head_javascripts %}
        {% endblock %}

        <!-- Google Tag Manager -->
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-PC9DMP59');</script>
        <!-- End Google Tag Manager -->

        <script src="https://www.google.com/recaptcha/api.js" async defer></script>

        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8291639383327901" crossorigin="anonymous"></script>
    </head>
    <body class="section-bg">
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PC9DMP59"
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
        
        {% block body %}{% endblock %}

        {% block body_javascripts %}
        {% endblock %}
    </body>
</html>
